<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass surface: translucent fill, light sheen at the top, bright hairline rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient android:type="linear" android:angle="270"
        android:startColor="#5CFFFFFF"  android:endColor="#2EFFFFFF" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
</shape>
